{
  "name": "discord-music-selfbot",
  "version": "1.0.0",
  "description": "Discord music selfbot - plays local mp3/mp4, YouTube and Spotify",
  "main": "bot.ts",
  "scripts": {
    "start": "tsx --env-file=.env bot.ts",
    "dev": "tsx --env-file=.env --inspect-brk bot.ts",
    "github": "tsx bot.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "selfbot",
    "music"
  ],
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "discord.js-selfbot-v13": "^3.4.1",
    "ffmpeg-static": "^5.2.0",
    "opusscript": "^0.1.1",
    "tweetnacl": "^1.0.3"
  }
}
